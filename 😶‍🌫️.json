{
    "enhConfig": {
        "enhKey": "😶‍🌫️",
        "spawn": "be-decked-with/be-decked-with.js",
        "withAttrs": {
            "base": "😶‍🌫️",
            "_base": {
                "instanceOf": "String",
                "mapsTo": "path"
            },
            "src": "${base}-src",
            "_src": {
                "instanceOf": "String",
                "mapsTo": "src"
            }
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "actions": {
            "upShadowSearch": {
                "ifAllOf": [
                    "enhancedElement",
                    "path"
                ],
                "ifNoneOf": [
                    "resolved"
                ]
            },
            "fetchRemoteTemplate": {
                "ifAllOf": [
                    "enhancedElement",
                    "src"
                ],
                "ifNoneOf": [
                    "resolved"
                ]
            },
            "act": {
                "ifAllOf": [
                    "enhancedElement",
                    "template"
                ],
                "ifNoneOf": [
                    "resolved"
                ]
            }
        }
    }
}
